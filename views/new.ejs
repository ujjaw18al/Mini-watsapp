<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>create new chat route</title>
    <link rel="stylesheet" href="/new.css">
</head>
<body>
    <div class="chat-container">
         <h3> Add a new chat</h3>
    <form method="post" action="/chats">
        <input type="text"  placeholder="Who are you? " name="from">
        <br>
        <br>
        <textarea name="msg"  placeholder="write here message "></textarea>
        <br>
        <br>
        <input type="text" placeholder="add reciver" name="to">
        <br>
        <br>

        <button>Create chat</button>
    </form>
    </div>
   
</body>
</html>